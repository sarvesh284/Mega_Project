## Base URL of the Node/Express backend's API. The frontend never talks to
## the Python AI service or Sarvam directly - only to this Node API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

## Optional request timeouts (milliseconds). VITE_API_TIMEOUT_MS applies to
## ordinary requests (default 30000). VITE_AI_REQUEST_TIMEOUT_MS applies to
## requests that wait on the AI service - voice extract/confirm and job
## creation (default 660000). Keep it longer than the backend's
## AI_SERVICE_INFERENCE_TIMEOUT_MS so the backend's own error arrives first.
# VITE_API_TIMEOUT_MS=30000
# VITE_AI_REQUEST_TIMEOUT_MS=660000
