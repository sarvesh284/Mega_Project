## AI service's own port (read by uvicorn/whatever process manager runs it).
## 8001, because the Node backend occupies 8000.
PORT=8001

## Shared secret Node must send back to this service as the X-AI-Service-Key
## header. Leave empty for local development - when unset, the API allows
## requests without a key.
AI_SERVICE_API_KEY=

## Not read by this service itself - documented here for the Node side,
## which needs to know where to send requests. Must agree with PORT above.
AI_SERVICE_URL=http://localhost:8001

## Speech-to-text provider for /voice/extract - "mlx_whisper" (local,
## Apple Silicon only, default), "whisper" (local, openai-whisper/PyTorch,
## works on any platform), or "sarvam" (cloud, kept available as a
## fallback/compatibility provider). Profile extraction and translation are
## independently provider-selectable too - see EXTRACTION_PROVIDER below.
STT_PROVIDER=mlx_whisper

## Local Whisper via Apple's MLX runtime (Metal/ANE-accelerated) - used
## when STT_PROVIDER=mlx_whisper. Apple Silicon only; not installable/
## runnable on Linux or Intel Macs, so a non-Apple-Silicon deployment must
## use STT_PROVIDER=whisper or =sarvam instead. The caller's language hint
## (mr/hi/en) is forwarded as primary language conditioning - a real
## Marathi test showed this model misdetecting Gujarati with no hint. The
## hint only anchors the primary language, not a vocabulary restriction:
## embedded English terms (e.g. "plumber") still transcribe correctly. An
## unrecognized/missing hint falls back to automatic detection.
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

## Local extraction provider - "local_llm" (mlx-lm, Apple Silicon only,
## default) or "sarvam" (cloud, kept available as a fallback/compatibility
## provider).
EXTRACTION_PROVIDER=local_llm

## Local instruct model for structured profile extraction via mlx-lm - used
## when EXTRACTION_PROVIDER=local_llm. Apple Silicon only, same constraint
## as MLX_WHISPER_MODEL above.
LOCAL_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

## Local Whisper via openai-whisper/PyTorch (CPU or MPS) - used when
## STT_PROVIDER=whisper. Runs on any platform, unlike the mlx_whisper
## provider above.
## Model sizes: tiny/base/small/medium/large - "small" is the practical
## default for multilingual (incl. Marathi/Hindi) accuracy vs. speed/memory
## on a local development machine; smaller models are noticeably worse at
## Indic languages and code-switching.
WHISPER_MODEL=small
## "auto" (default) tries Apple Silicon MPS (Metal) and falls back to CPU
## automatically - both at model-load time and, if MPS errors during
## inference, by transparently retrying once on CPU. Set explicitly to
## "cpu" or "mps" to force one.
WHISPER_DEVICE=auto
## fp16 half-precision inference. Off by default - MPS + fp16 has known
## reliability issues for Whisper's conv/attention ops on some PyTorch
## versions; CPU never supports fp16. Only meaningful with WHISPER_DEVICE=mps.
WHISPER_FP16=false

## Sarvam AI (profile extraction, translation, and STT when
## STT_PROVIDER=sarvam) - https://docs.sarvam.ai/. If unset, Sarvam-backed
## endpoints/providers return 503 rather than producing simulated data;
## Node's thin wrappers decide what to do with that (translation falls back
## to source-language passthrough, voice extraction propagates the failure).
SARVAM_API_KEY=
## STT model - "saaras:v3" is the current documented default/recommended
## production model; "saaras:v4" (2026-09) adds broader language coverage.
SARVAM_STT_MODEL=saaras:v3
## Chat model used for structured worker-profile extraction from a transcript.
SARVAM_EXTRACTION_MODEL=sarvam-105b
## Translation model - mayura:v1 covers mr/hi/en.
SARVAM_TRANSLATION_MODEL=mayura:v1
